      "targets": [
        {
          "queryType": "metrics",
          "profileTypeId": "memory:alloc_in_new_tlab_bytes:bytes:space:bytes",
          "labelSelector": "{service_name=\"employee-api\"}",
          "legendFormat": "alloc bytes",
          "refId": "A"
        },
        {
          "queryType": "metrics",
          "profileTypeId": "memory:alloc_in_new_tlab_objects:count:space:bytes",
          "labelSelector": "{service_name=\"employee-api\"}",
          "legendFormat": "alloc count",
