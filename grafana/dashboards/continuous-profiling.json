{
  "uid": "employee-api-continuous-profiling",
  "title": "Employee API - Continuous Profiling",
  "description": "CPU, memory allocation, and lock contention profiles via Pyroscope",
  "tags": ["profiling", "employee-api"],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "CPU",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "CPU Profile Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "queryType": "metrics",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=\"employee-api\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "flamegraph",
      "title": "CPU Flame Graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "queryType": "profile",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=\"employee-api\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Memory / Allocation",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Allocation Profile Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
