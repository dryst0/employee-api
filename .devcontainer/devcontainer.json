{
  "name": "Employee API",
  "image": "ghcr.io/dryst0/devcontainer:latest",

  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW", "-p", "127.0.0.1:3000:3000"],

  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "25" },
    "ghcr.io/devcontainers-extra/features/apt-packages:1": { "packages": "postgresql-client" }
  },

  "remoteUser": "dev",

  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig-host,type=bind,readonly",
    "source=shared-maven-cache,target=/home/dev/.m2,type=volume",
    "source=shared-docker-cache,target=/var/lib/docker,type=volume",
    "source=employee-api-history,target=/commandhistory,type=volume"
  ],

  "containerEnv": {
    "TESTCONTAINERS_RYUK_DISABLED": "true",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "FIREWALL_ALLOWED_DOMAINS": "repo.maven.apache.org"
  },

  "postCreateCommand": ".devcontainer/post-create.sh",
  "waitFor": "postStartCommand"
}
